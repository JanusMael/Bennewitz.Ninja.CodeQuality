<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Versioning">
    <PackageVersion Include="Bennewitz.Ninja.AutoVersioning" Version="2026.3.916" />
  </ItemGroup>

  <PropertyGroup Label="Roslyn">
    <!-- ⚠ The oldest compiler a consumer can use: an analyzer compiled against Roslyn X loads in
         every compiler X or later and in none before it. 4.14.0 matches Bennewitz.Ninja.AutoVersioning,
         the family's other analyzer, by the maintainer's choice on 2026-09-25. It is not what the
         rules need: measured, they build and pass on 4.0.1, and 3.11 cannot compile them, because
         file-scoped namespaces arrived in Roslyn 4.0. So the pin can move down to 4.0.1 without a
         code change, and it moves up only for an API the rules cannot do without. The tests resolve
         the same version through Microsoft.CodeAnalysis.CSharp.Workspaces, so the rules are proved
         on the oldest compiler the package claims to support. -->
    <RoslynVersion>4.14.0</RoslynVersion>
  </PropertyGroup>

  <ItemGroup Label="Roslyn">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" />
    <!-- ⛔ The testing package floors this at 1.0.1 and raises it for nobody; without this pin the
         tests restore a 2015 Workspaces (NU1701) and run the analyzer on nothing like a consumer's
         compiler. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynVersion)" />
    <!-- The rules for analyzer authors (RS****). Build-time only; the newest is fine. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- xunit.v3 on Microsoft.Testing.Platform — see global.json. The VSTest bridge packages are
         deliberately absent; TrxReport is what gives CI its .trx files. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- ⚠ Same Microsoft.Testing.Platform line as xunit.v3 3.2.2 (1.9.1). A NEWER TrxReport pins
         the platform above what xunit's bundled MSBuild extension can load, and the failure reads
         as an unrelated loader error. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" />
  </ItemGroup>
</Project>
